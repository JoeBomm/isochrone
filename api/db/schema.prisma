datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = "native"
}

// Core data models for isochrone application

model Location {
  id        String   @id @default(cuid())
  name      String
  address   String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("locations")
}

model IsochroneCache {
  id                String   @id @default(cuid())
  pointId           String   @map("point_id")
  travelTimeMinutes Int      @map("travel_time_minutes")
  travelMode        String   @map("travel_mode")
  geojson           String
  createdAt         DateTime @default(now()) @map("created_at")
  expiresAt         DateTime @map("expires_at")

  @@index([pointId, travelTimeMinutes, travelMode])
  @@index([expiresAt])
  @@map("isochrone_cache")
}

model MatrixCache {
  id               String   @id @default(cuid())
  originsHash      String   @map("origins_hash")
  destinationsHash String   @map("destinations_hash")
  travelMode       String   @map("travel_mode")
  matrixData       String   @map("matrix_data")
  createdAt        DateTime @default(now()) @map("created_at")
  expiresAt        DateTime @map("expires_at")

  @@index([originsHash, destinationsHash, travelMode])
  @@index([expiresAt])
  @@map("matrix_cache")
}

model GeocodingCache {
  id        String   @id @default(cuid())
  address   String   @unique
  latitude  Float
  longitude Float
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([address])
  @@index([expiresAt])
  @@map("geocoding_cache")
}
