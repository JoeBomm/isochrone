# Environment variables for RedwoodSDK project
# Copy this file to .env and fill in your actual values

# OpenRouteService API Key (required)
OPENROUTE_SERVICE_API_KEY=your_openroute_service_api_key_here

# Development environment
NODE_ENV=development

# Cloudflare configuration (for production)
# These will be set via wrangler secrets in production
# CLOUDFLARE_ACCOUNT_ID=your_account_id
# CLOUDFLARE_API_TOKEN=your_api_token

# Database configuration (local development)
# D1 database will be created automatically by Miniflare
DATABASE_URL=local-d1-database

# Optional: Custom port for local development
PORT=8787
