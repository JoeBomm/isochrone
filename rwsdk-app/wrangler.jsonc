{
  // Schema reference for wrangler configuration
  "$schema": "node_modules/wrangler/config-schema.json",

  // Name of your worker
  "name": "meeting-point-finder",

  // Entry point for your worker
  "main": "src/worker.tsx",

  // Compatibility settings
  "compatibility_date": "2025-08-21",
  "compatibility_flags": ["nodejs_compat"],

  // Assets configuration
  "assets": {
    "binding": "ASSETS"
  },

  // Observability settings
  "observability": {
    "enabled": true
  },

  // KV read-through cache. PLACEHOLDER id: replace with the real namespace id
  // (npx wrangler kv namespace create CACHE) before deploying.
  "kv_namespaces": [
    { "binding": "CACHE", "id": "00000000000000000000000000000000" }
  ],

  // Per-client rate limits (Workers Rate Limiting binding), keyed by
  // CF-Connecting-IP; see src/server/rateLimit.ts. `namespace_id` is a
  // user-chosen positive integer (as a string) that must be unique within the
  // Cloudflare account; no resource has to be created. `period` must be 10
  // or 60 and must match RATE_LIMIT_PERIOD_SECONDS. Limits are approximate
  // and per Cloudflare location. The limits mirror RATE_LIMITS in
  // src/server/rateLimit.ts (a test checks they match), which documents the
  // arithmetic.
  //
  // Sized against the ORS Standard (free) plan, checked 2026-11-19:
  // matrix 500/day 40/min, isochrones 500/day 20/min, geocode search
  // 1000/day 100/min. One uncached action = one ORS request.
  //   find       5/min: one IP drains matrix in 500/5 = 100 min
  //   isochrone  6/min: one IP drains isochrones in 500/6 ≈ 83 min
  //   geocode   30/min: one IP drains geocode in 1000/30 ≈ 33 min
  //                     (kept: normal typing needs the headroom)
  //
  // RESIDUAL RISK: these cap a client per minute; they are NOT a daily
  // budget, which the binding cannot express. A client varying its inputs
  // (no cache hits) can still drain the shared ORS daily quota: N IPs at the
  // limit send N x limit x 1440 requests/day, so one IP drains it in the
  // times above, N IPs in 1/N of that. Users then get the 'quota' error until
  // ORS renews the quota. A strict global budget would need a Durable Object.
  "ratelimits": [
    { "name": "FIND_RATE_LIMITER", "namespace_id": "4601", "simple": { "limit": 5, "period": 60 } },
    { "name": "ISOCHRONE_RATE_LIMITER", "namespace_id": "4602", "simple": { "limit": 6, "period": 60 } },
    { "name": "GEOCODE_RATE_LIMITER", "namespace_id": "4603", "simple": { "limit": 30, "period": 60 } }
  ],

  // Optional non-secret var ORS_BASE_URL overrides the ORS endpoint (e2e
  // mocks); unset = https://api.openrouteservice.org. Set it in .dev.vars for
  // local runs rather than here, so production always uses the real endpoint.
  //
  // Do NOT put ORS_API_KEY here. It is a Worker secret:
  //   npx wrangler secret put ORS_API_KEY   (local dev: .dev.vars)
  "vars": {}
}
